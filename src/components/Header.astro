---
import { Image } from 'astro:assets';
import logo from '../assets/images/logo.png';
import { NAV, SITE } from '../data/site';

const currentPath = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="site-header__logo" aria-label="Max Pavage — accueil">
      <Image src={logo} alt="Max Pavage" height={56} densities={[1, 2]} loading="eager" />
    </a>
    <button
      class="site-header__toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      aria-label="Ouvrir le menu"
    >
      <span></span><span></span><span></span>
    </button>
    <nav id="site-nav" class="site-header__nav" aria-label="Navigation principale">
      <ul>
        {
          NAV.map((item) => (
            <li>
              <a href={item.href} aria-current={currentPath === item.href ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="site-header__actions">
        <a href={SITE.phoneHref} class="site-header__phone" data-gtag-event="phone_call">
          {SITE.phone}
        </a>
        <a href="/contactus" class="btn btn--primary">Contactez-nous</a>
      </div>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--white);
    box-shadow: 0 2px 12px rgba(13, 15, 20, 0.08);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.6rem;
  }

  .site-header__logo {
    flex-shrink: 0;
  }

  .site-header__logo img {
    width: auto;
    height: 56px;
  }

  .site-header__nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .site-header__nav ul {
    display: flex;
    align-items: center;
    gap: 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-header__nav ul a {
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--text);
    text-decoration: none;
    white-space: nowrap;
  }

  .site-header__nav ul a:hover,
  .site-header__nav ul a[aria-current='page'] {
    color: var(--primary);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .site-header__phone {
    font-family: var(--font-heading);
    font-weight: 600;
    color: var(--primary);
    text-decoration: none;
    white-space: nowrap;
  }

  .site-header__toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: 0;
    padding: 0.5rem;
    cursor: pointer;
  }

  .site-header__toggle span {
    width: 24px;
    height: 2.5px;
    background: var(--dark);
    border-radius: 2px;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  @media (max-width: 1080px) {
    .site-header__toggle {
      display: flex;
    }

    .site-header__nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: flex-start;
      background: var(--white);
      padding: 1.25rem;
      box-shadow: 0 12px 20px rgba(13, 15, 20, 0.12);
      display: none;
    }

    .site-header__nav.is-open {
      display: flex;
    }

    .site-header__nav ul {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.9rem;
    }

    .site-header__actions {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.site-header__toggle');
  const nav = document.getElementById('site-nav');
  toggle?.addEventListener('click', () => {
    const open = nav?.classList.toggle('is-open') ?? false;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Fermer le menu' : 'Ouvrir le menu');
  });
</script>
