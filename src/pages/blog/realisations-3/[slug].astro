---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import Cta from '../../../components/Cta.astro';
import { TAGS } from '../../../data/tags';
import { SITE } from '../../../data/site';

export async function getStaticPaths() {
  const realisations = await getCollection('realisations');
  return realisations.map((realisation) => ({
    params: { slug: realisation.id },
    props: { realisation },
  }));
}

interface Props {
  realisation: CollectionEntry<'realisations'>;
}

const { realisation } = Astro.props;
const { title, description, date, location, tag, cover, coverAlt } = realisation.data;
const { Content } = await render(realisation);
const dateLabel = new Intl.DateTimeFormat('fr-BE', { dateStyle: 'long' }).format(date);
const path = `/blog/realisations-3/${realisation.id}`;

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: date.toISOString(),
  image: `${SITE.domain}${cover.src}`,
  author: { '@type': 'Organization', name: SITE.legalName },
  publisher: { '@id': `${SITE.domain}/#business` },
  mainEntityOfPage: `${SITE.domain}${path}`,
};
---

<Base
  title={`${title} | Max Pavage`}
  description={description}
  path={path}
  ogImage={cover.src}
  ogType="article"
  jsonLd={[articleJsonLd]}
>
  <article class="section">
    <div class="container realisation">
      <header class="realisation__header">
        <p class="realisation__meta">
          <a href="/blog/realisations-3" class="realisation__back">← Toutes les réalisations</a>
        </p>
        <h1>{title}</h1>
        <p class="realisation__meta">
          <span class="realisation__tag">{TAGS[tag]}</span>
          {location && <span> · {location}</span>}
          <span> · </span>
          <time datetime={date.toISOString().slice(0, 10)}>{dateLabel}</time>
        </p>
        <Image
          src={cover}
          alt={coverAlt ?? title}
          widths={[480, 800, 1200]}
          sizes="(max-width: 900px) 100vw, 860px"
          class="realisation__cover"
          loading="eager"
        />
      </header>
      <div class="realisation__content">
        <Content />
      </div>
    </div>
  </article>

  <Cta title="+140 chantiers, 72H pour votre devis" subtitle="Une de nos réalisations vous intéresse ? Demandez un devis !" />
</Base>

<style>
  .realisation {
    max-width: 860px;
  }

  .realisation__back {
    font-family: var(--font-heading);
    font-size: 0.9rem;
    text-decoration: none;
  }

  .realisation__meta {
    color: var(--text-muted);
  }

  .realisation__tag {
    font-family: var(--font-heading);
    font-weight: 600;
    color: var(--primary);
  }

  .realisation__cover {
    width: 100%;
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    margin-top: 1.5rem;
    object-fit: cover;
    max-height: 540px;
  }

  .realisation__content {
    margin-top: 2rem;
  }

  .realisation__content :global(img) {
    width: 100%;
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    margin-block: 1.25rem;
  }

  .realisation__content :global(h2),
  .realisation__content :global(h3) {
    margin-top: 2.25rem;
    color: var(--primary);
  }
</style>
