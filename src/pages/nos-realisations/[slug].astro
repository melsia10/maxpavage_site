---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Cta from '../../components/Cta.astro';
import { TAGS } from '../../data/tags';
import { SITE } from '../../data/site';

export async function getStaticPaths() {
  const realisations = await getCollection('realisations');
  return realisations.map((realisation) => ({
    params: { slug: realisation.id },
    props: { realisation },
  }));
}

interface Props {
  realisation: CollectionEntry<'realisations'>;
}

const { realisation } = Astro.props;
const { title, description, date, location, tag, cover, coverAlt, gallery, videos } = realisation.data;

function toEmbedUrl(url: string): string | null {
  const yt = url.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/)([a-zA-Z0-9_-]{11})/);
  if (yt) return `https://www.youtube.com/embed/${yt[1]}`;
  const vimeo = url.match(/vimeo\.com\/(\d+)/);
  if (vimeo) return `https://player.vimeo.com/video/${vimeo[1]}`;
  return null;
}
const { Content } = await render(realisation);
const dateLabel = new Intl.DateTimeFormat('fr-BE', { dateStyle: 'long' }).format(date);
const path = `/nos-realisations/${realisation.id}`;

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: date.toISOString(),
  image: `${SITE.domain}${cover.src}`,
  author: { '@type': 'Organization', name: SITE.legalName },
  publisher: { '@id': `${SITE.domain}/#business` },
  mainEntityOfPage: `${SITE.domain}${path}`,
};
---

<Base
  title={`${title} | Max Pavage`}
  description={description}
  path={path}
  ogImage={cover.src}
  ogType="article"
  jsonLd={[articleJsonLd]}
>
  <article class="section">
    <div class="container realisation">
      <header class="realisation__header">
        <p class="realisation__meta">
          <a href="/nos-realisations" class="realisation__back">← Toutes les réalisations</a>
        </p>
        <h1>{title}</h1>
        <p class="realisation__meta">
          <span class="realisation__tag">{TAGS[tag]}</span>
          {location && <span> · {location}</span>}
          <span> · </span>
          <time datetime={date.toISOString().slice(0, 10)}>{dateLabel}</time>
        </p>
        <Image
          src={cover}
          alt={coverAlt ?? title}
          widths={[480, 800, 1200]}
          sizes="(max-width: 900px) 100vw, 860px"
          class="realisation__cover"
          loading="eager"
        />
      </header>
      <div class="realisation__content">
        <Content />
      </div>
      {videos && videos.length > 0 && (
        <div class="realisation__videos">
          {videos.map((video) => {
            const embedUrl = toEmbedUrl(video.url);
            if (!embedUrl) return null;
            return (
              <figure class="realisation__video-figure">
                <div class="realisation__video-wrapper">
                  <iframe
                    src={embedUrl}
                    title={video.label ?? title}
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                    allowfullscreen
                    loading="lazy"
                  />
                </div>
                {video.label && <figcaption class="realisation__video-caption">{video.label}</figcaption>}
              </figure>
            );
          })}
        </div>
      )}
      {gallery && gallery.length > 0 && (
        <div class="realisation__gallery">
          {gallery.map((item) => (
            <Image
              src={item.src}
              alt={item.alt ?? title}
              widths={[480, 800]}
              sizes="(max-width: 600px) 100vw, 50vw"
              class="realisation__gallery-img"
            />
          ))}
        </div>
      )}
    </div>
  </article>

  <Cta title="+140 chantiers, 72H pour votre devis" subtitle="Une de nos réalisations vous intéresse ? Demandez un devis !" />
</Base>

<style>
  .realisation {
    max-width: 860px;
  }

  .realisation__back {
    font-family: var(--font-heading);
    font-size: 0.9rem;
    text-decoration: none;
  }

  .realisation__meta {
    color: var(--text-muted);
  }

  .realisation__tag {
    font-family: var(--font-heading);
    font-weight: 600;
    color: var(--primary);
  }

  .realisation__cover {
    width: 100%;
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    margin-top: 1.5rem;
    object-fit: cover;
    max-height: 540px;
  }

  .realisation__content {
    margin-top: 2rem;
  }

  .realisation__content :global(img) {
    width: 100%;
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    margin-block: 1.25rem;
  }

  .realisation__content :global(h2),
  .realisation__content :global(h3) {
    margin-top: 2.25rem;
    color: var(--primary);
  }

  .realisation__gallery {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    margin-top: 2rem;
  }

  @media (max-width: 600px) {
    .realisation__gallery {
      grid-template-columns: 1fr;
    }
  }

  .realisation__gallery-img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  .realisation__videos {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    margin-top: 2rem;
  }

  .realisation__video-figure {
    margin: 0;
  }

  .realisation__video-wrapper {
    position: relative;
    padding-bottom: 56.25%; /* 16:9 */
    height: 0;
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
  }

  .realisation__video-wrapper iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: none;
  }

  .realisation__video-caption {
    margin-top: 0.5rem;
    font-size: 0.9rem;
    color: var(--text-muted);
    text-align: center;
  }
</style>
